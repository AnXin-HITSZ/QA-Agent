# 复制为 .env 后按需修改。
APP_ENV=dev

# LLM —— .env 驱动,第二步随 LangGraph 由 LangChain ChatOpenAI 创建。
# 任意 OpenAI 兼容端点(OpenAI / DeepSeek / 通义千问 / 智谱GLM / Kimi / vLLM ...),换厂商只改这几行。
# 示例(DeepSeek): LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
# 示例(OpenAI):   LLM_BASE_URL=https://api.openai.com/v1    LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_REQUEST_TIMEOUT=60

# Embeddings(RAG 向量化)—— OpenAI 兼容端点。DeepSeek 无 embeddings,需另配。
# 示例(阿里云 DashScope 兼容模式):text-embedding-v4 默认 1024 维;换模型请同步改 EMBEDDINGS_DIM。
EMBEDDINGS_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-v4
EMBEDDINGS_DIM=1024
# embeddings 模型版本标识:供应商没有固定版本号时人工维护;换模型 / 主动失效缓存时 +1。
EMBEDDINGS_VERSION=1

# Qdrant 向量库 —— 指向你的 Qdrant(如阿里云 ECS)。留空则 RAG 不可用。
# 安全:公网暴露务必设 API Key + 安全组只放行后端/开发机 IP,别开 0.0.0.0。
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=lab_knowledge

# 阿里云 OSS —— RAG 原件仓库,存原始文档 blob(专利/发票/证书…)。留空则知识库存储不可用。
# 架构:原件存 OSS(唯一事实源,抗 ECS 重建)+ ECS 的 Qdrant 只放向量+元数据;
#       引用来源用短时效签名 URL 指回原件。
# 安全:务必用【私有】桶(关闭公共读写)+ 服务端加密(SSE)+ RAM 子账号最小权限
#       (只授权本桶本前缀的读写),AccessKey 只放这里、绝不提交仓库。
# 例:OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com  OSS_BUCKET=lab-knowledge
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=knowledge/
# SOP 文档在同一个桶内的根前缀(与知识库分开;SOP 已从本地目录迁到 OSS)。
OSS_SOPS_PREFIX=sops/

# OCR —— 把扫描件 / 图片逐页抽成文本(PDF 按页渲染成图后送识别)。
# 留空 = 关闭:没有文本层的文件按「需 OCR」跳过并注明原因(不阻断整批,也不产生费用)。
# 已实现的引擎:aliyun(阿里云「OCR 统一识别」RecognizeAllText,与 OSS / DashScope 同体系)。
# 提取方式由用户在前端逐次显式选择(不使用 OCR / 通用文字识别(基础版或高精版)/
# 发票识别(可含混贴票据页)/ 付款详情识别),不做自动分类、前缀路由或自动切换;
# 只有选了 OCR 方式的那次索引才调用云端 OCR。
OCR_ENGINE=
# 阿里云 OCR 凭证:与 DashScope 的模型 Key 不同,与 OSS 的 AK 也是两套权限 ——
# 能读 OSS 不代表能调 OCR。建议单独建 RAM 子账号,只授权 OCR 接口(如系统策略 AliyunOCRFullAccess)。
# 密钥只放服务端;未配置时选择 OCR 方式会明确报错,不会静默按原生提取。
OCR_ALIYUN_ACCESS_KEY_ID=
OCR_ALIYUN_ACCESS_KEY_SECRET=
# 已开通 OCR 服务的地域端点(与桶 / ECS 同地域延迟更低)。
# 例:ocr-api.cn-hangzhou.aliyuncs.com
OCR_ALIYUN_ENDPOINT=ocr-api.cn-hangzhou.aliyuncs.com
# 索引任务状态 / 版本指针 / 缓存清单与删除恢复记录的本地目录(相对后端工作目录)。
# 识别结果、转换文本、向量与文件登记都在 Redis(见下方 CACHE_BACKEND);
# 这里只留任务与恢复记录,内容可重建,不要放进 OSS 桶。
INDEX_STATE_DIR=data/ocr
# 单页识别的超时(秒)与最大重试次数(仅超时 / 限流 / 5xx 重试;失败结果不写缓存)。
OCR_TIMEOUT_SECONDS=30
OCR_MAX_RETRIES=2
# PDF 扫描页渲染分辨率与单页像素上限(超限按比例降采样,防超大页面撑爆内存)。
OCR_RENDER_DPI=200
OCR_MAX_PAGE_PIXELS=25000000

# Redis —— 一个实例承担三件事:会话记忆(checkpointer)、待办清单、RAG 三层结果缓存
# 与文件登记。留空则:会话退化为单轮模式,索引任务在建任务时直接报错(除非关缓存,见下)。
# ⚠️ checkpointer 依赖 RedisJSON + RediSearch 模块(Redis 8.0+ 内置;更低版本需 Redis Stack);
#    结果缓存与文件登记只用 String,不需要模块。验证:redis-cli MODULE LIST 应能看到 search 与 ReJSON。
# 安全:公网别裸奔 —— 设 requirepass 密码 + 安全组只放行后端/开发机 IP,别开 0.0.0.0。
# 例:redis://:你的密码@<ECS-IP>:6379/0
REDIS_URL=
# 会话记忆存活分钟数;0 表示永不过期(自动清理长期不活跃会话时再设)。
REDIS_TTL_MINUTES=0

# 三层结果缓存 + 文件身份登记(docs/Redis缓存与文件身份管理技术方案.md)。
# redis(默认,用上面的 REDIS_URL)| memory(仅测试)| none(显式关闭缓存:OCR 与向量化
# 每次都重新付费调用,只限本地没有 Redis 的开发环境)。未配置 REDIS_URL 时索引任务会报错,
# 不会把「连不上」当成缓存未命中继续花钱。
CACHE_BACKEND=redis
# 单条 Redis 命令的连接 / 读写超时(秒);计算锁有效期(秒,长计算自动按半程续期);
# 没抢到锁时最多等多久(秒);等不到返回可重试的忙碌状态(HTTP 503),不会绕过锁自行付费计算
# (锁过期 / 进程崩溃仍可能重复计费,不承诺严格一次)。
CACHE_REDIS_TIMEOUT_SECONDS=5
CACHE_LOCK_TTL_SECONDS=120
CACHE_LOCK_WAIT_SECONDS=90
# ⚠️ 部署侧要求(应用启动时不会替你改共享 Redis 的全局配置):
#   maxmemory <容量>  +  maxmemory-policy noeviction
#   并开启 AOF(appendfsync everysec)与可恢复备份、数据目录持久挂载。
#   达到内存上限时索引任务会暂停并明确报错,已有索引继续可用。

# 调用日志与费用统计(MySQL;docs/调用日志与费用统计技术方案.md)
# 记录 embedding / OCR 的**真实外部调用**与按配置单价的**估算费用**(不是官方账单,不含聊天 LLM),
# 不落文档正文 / 向量 / 图片 / 完整查询文本,不保存任何密钥与签名 URL。
# 与缓存分开:Redis 继续只做缓存与会话,这里只做日志与计量。
# 未配置 METERING_MYSQL_URL 时整层静默关闭(不影响 OCR / 索引 / 检索,只是不留记录)。
METERING_ENABLED=true
# 例(同机 MySQL):mysql+pymysql://qa_agent:密码(特殊字符按 URL 编码)@127.0.0.1:3306/qa_agent_prod?charset=utf8mb4
# 后端在 Docker 里就把主机名换成服务名 / 网段地址;不要把 3306 暴露到公网。
# 运行时账号只给 SELECT/INSERT/UPDATE/DELETE;建表 / 迁移用另一个账号执行 backend/migrations 下的 SQL(见方案 §9)。
METERING_MYSQL_URL=
# 连接池按「每个 uvicorn worker 各一份」算:总连接 ≈ workers × (pool + overflow)。
METERING_MYSQL_POOL_SIZE=5
METERING_MYSQL_MAX_OVERFLOW=5
METERING_MYSQL_POOL_RECYCLE_SECONDS=1800       # 小于 MySQL wait_timeout,避免用陈旧连接
METERING_MYSQL_CONNECT_TIMEOUT_SECONDS=5
METERING_MYSQL_READ_TIMEOUT_SECONDS=10
METERING_MYSQL_WRITE_TIMEOUT_SECONDS=10
# 数据库不可用时的本地补写目录(故障恢复队列,不是第二份可查询日志库;需可写、别放进 OSS 桶)。
METERING_PENDING_DIR=data/metering-pending
METERING_QUEUE_MAX=5000                        # 进程内待写队列上限,满了直接落补写目录(不丢)
METERING_FLUSH_BATCH=200
METERING_FLUSH_INTERVAL_SECONDS=2
METERING_PRICE_CACHE_SECONDS=60                # 价格表内存缓存时长,改价最多滞后这么久(写入后立即失效)
# 价格在「调用与费用 → 估算依据」页面里维护(写入 price_config 表,只增 + 删):
# 按 服务/供应商/模型或 OCR Type/计费单位 配置,必须引用官方价格来源与核实日期;
# 没配价格时界面显示「无法估算」,绝不显示 0。

# 前端 Vue3 开发服务器地址(逗号分隔),用于 CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
