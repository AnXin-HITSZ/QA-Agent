# 复制为 .env 后按需修改。
APP_ENV=dev

# LLM —— .env 驱动,第二步随 LangGraph 由 LangChain ChatOpenAI 创建。
# 任意 OpenAI 兼容端点(OpenAI / DeepSeek / 通义千问 / 智谱GLM / Kimi / vLLM ...),换厂商只改这几行。
# 示例(DeepSeek): LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
# 示例(OpenAI):   LLM_BASE_URL=https://api.openai.com/v1    LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_REQUEST_TIMEOUT=60

# SOP / Skill 目录(留空则用 backend/sops)
# SOPS_DIR=

# Embeddings(RAG 向量化)—— OpenAI 兼容端点。DeepSeek 无 embeddings,需另配。
# 示例(阿里云 DashScope 兼容模式):text-embedding-v4 默认 1024 维;换模型请同步改 EMBEDDINGS_DIM。
EMBEDDINGS_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-v4
EMBEDDINGS_DIM=1024

# Qdrant 向量库 —— 指向你的 Qdrant(如阿里云 ECS)。留空则 RAG 不可用。
# 安全:公网暴露务必设 API Key + 安全组只放行后端/开发机 IP,别开 0.0.0.0。
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=lab_knowledge

# Redis —— LangGraph checkpointer,存 Agent 跨轮对话记忆。留空则单轮模式(无跨轮记忆)。
# ⚠️ 依赖 RedisJSON + RediSearch 模块:Redis 8.0+ 内置;更低版本需用 Redis Stack 或自行装模块。
#    验证:redis-cli MODULE LIST 应能看到 search 与 ReJSON。
# 安全:公网别裸奔 —— 设 requirepass 密码 + 安全组只放行后端/开发机 IP,别开 0.0.0.0。
# 例:redis://:你的密码@<ECS-IP>:6379/0
REDIS_URL=
# 会话记忆存活分钟数;0 表示永不过期(自动清理长期不活跃会话时再设)。
REDIS_TTL_MINUTES=0

# 前端 Vue3 开发服务器地址(逗号分隔),用于 CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
